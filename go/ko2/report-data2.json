  },
  {
   "f": "src/data/content/ch11.js",
   "l": 45,
   "t": "Cold Triage"
  },
  {
   "f": "src/data/content/ch11.js",
   "l": 47,
   "t": "Glitter Shriek"
  },
  {
   "f": "src/data/content/ch11.js",
   "l": 88,
   "t": "It swims through the glass dunes the way an eel swims through weed. The dunes are in the sky now. It has not noticed."
  },
  {
   "f": "src/data/content/ch11.js",
   "l": 93,
   "t": "A memory of water seen by someone dying of thirst."
  },
  {
   "f": "src/data/content/ch11.js",
   "l": 95,
   "t": "Choir Husk"
  },
  {
   "f": "src/data/content/ch11.js",
   "l": 98,
   "t": "Blindfolded and singing one note. Tamsin's acolytes sang the Dawnsong with their eyes covered, so they would hear it bet"
  },
  {
   "f": "src/data/content/ch11.js",
   "l": 100,
   "t": "Glass Scuttler"
  },
  {
   "f": "src/data/content/ch11.js",
   "l": 103,
   "t": "Its shell is fused desert glass. Hit it hard enough and it rings."
  },
  {
   "f": "src/data/content/ch11.js",
   "l": 105,
   "t": "The Blind Choir"
  },
  {
   "f": "src/data/content/ch11.js",
   "l": 108,
   "t": "What remains of Keeper Tamsin: a choir of blindfolded voices singing so loudly they cannot hear the world end."
  },
  {
   "f": "src/data/content/ch11.js",
   "l": 110,
   "t": "Choir Voice"
  },
  {
   "f": "src/data/content/ch11.js",
   "l": 113,
   "t": "One voice of many. It sings harmony to a song no one else can hear."
  }
