  "tpl": false,
  "s": "Ember Harrier"
 },
 {
  "line": 74,
  "tpl": false,
  "s": "Gulls that flew too close to the broken sun."
 },
 {
  "line": 75,
  "tpl": false,
  "s": "Cinder Hound"
 },
 {
  "line": 75,
  "tpl": false,
  "s": "Coal-bellied dogs of the ash wastes."
 },
 {
  "line": 76,
  "tpl": false,
  "s": "Shard Crawler"
 },
 {
  "line": 76,
  "tpl": false,
  "s": "Grows a shell from fallen window-glass."
 },
 {
  "line": 77,
  "tpl": false,
  "s": "Ash Shade"
 },
 {
  "line": 77,
  "tpl": false,
  "s": "Ash that remembers being a person."
 },
 {
  "line": 79,
  "tpl": false,
  "s": "Belfry Bat"
 },
 {
  "line": 79,
  "tpl": false,
  "s": "They hang right-way-up now, which is to say, upside-down."
 },
 {
  "line": 80,
  "tpl": false,
  "s": "Still singing the wedding hymn. Still a little flat."
 },
 {
  "line": 81,
  "tpl": false,
  "s": "Clapper Golem"
 },
 {
  "line": 81,
  "tpl": false,
  "s": "A bell-clapper that grew arms. It strikes on the hour."
 },
 {
  "line": 82,
  "tpl": false,
  "s": "Hymn Wisp"
 },
 {
  "line": 82,
  "tpl": false,
  "s": "A note that refused to end."
 },
 {
  "line": 84,
  "tpl": false,
  "s": "Thorn Maw"
 },
 {
  "line": 84,
  "tpl": false,
  "s": "A white flower that bites the hand that waters it."
 },
 {
  "line": 85,
  "tpl": false,
  "s": "It eats the last words before they can be said."
 },
 {
  "line": 86,
  "tpl": false,
  "s": "Petal Wraith"
 },
 {
  "line": 86,
  "tpl": false,
  "s": "Someone who did not get to say goodbye."
 },
 {
  "line": 87,
  "tpl": false,
  "s": "Mourning Oak"
 },
 {
  "line": 87,
  "tpl": false,
  "s": "Planted over a grave a century ago. It grieves slowly."
 },
 {
  "line": 90,
  "tpl": false,
  "s": "Bounty. Ate a cart. The cart was occupied."
 },
 {
  "line": 91,
  "tpl": false,
  "s": "Bounty. Its lure is the last light many travelers saw."
 },
 {
  "line": 92,
  "tpl": false,
  "s": "Bounty. A cairn that got hungry."
 },
 {
  "line": 93,
  "tpl": false,
  "s": "Bounty. The toll is fingers."
 },
 {
  "line": 94,
  "tpl": false,
  "s": "Bounty. Still on patrol."
 },
 {
  "line": 95,
  "tpl": false,
  "s": "Bounty. Flew through the broken sun."
 },
 {
  "line": 96,
  "tpl": false,
  "s": "Bounty. Saints in its back."
 },
 {
  "line": 97,
  "tpl": false,
  "s": "Bounty. It speaks with the voices of the buried."
 },
 {
  "line": 98,
  "tpl": false,
  "s": "Bounty. Still conducting."
 },
 {
  "line": 99,
  "tpl": false,
  "s": "Bounty. Do not let her hold your hand."
 },
 {
  "line": 102,
  "tpl": false,
  "s": "The Orrery Warden"
 },
 {
  "line": 102,
  "tpl": false,
  "s": "Built by the first Keepers to guard what they chose never to do."
 },
 {
  "line": 103,
  "tpl": false,
  "s": "The Iron Duke"
 },
 {
  "line": 103,
  "tpl": false,
  "s": "The fort commander's ceremonial armor. Someone has to hold the stair."
 },
 {
  "line": 104,
  "tpl": false,
  "s": "The Hollow Bell"
 },
 {
  "line": 104,
  "tpl": false,
  "s": "A bell that would not stop ringing, because stopping meant goodbye."
 },
 {
  "line": 105,
  "tpl": false,
  "s": "The Last Bloom"
 },
 {
  "line": 105,
  "tpl": false,
  "s": "It wanted to keep every last word. It kept too many."
 },
 {
  "line": 107,
  "tpl": false,
  "s": "The Bane of Harrow"
 },
 {
  "line": 107,
  "tpl": false,
  "s": "Hidden hunt. It killed the Lodge's founder, and it remembers how he tasted."
 },
 {
  "line": 108,
  "tpl": false,
  "s": "Hidden hunt. It does not shine. It takes."
 },
 {
  "line": 175,
  "tpl": false,
  "s": "Bristleback paws the ground, head low..."
 },
 {
  "line": 179,
  "tpl": false,
  "s": "The lure brightens. Something huge opens beneath it..."
 },
 {
  "line": 182,
  "tpl": false,
  "s": "Gravelgut swallows a cairn and hardens!"
 },
 {
  "line": 183,
  "tpl": false,
  "s": "Gravelgut rears up, stones grinding..."
 },
 {
  "line": 186,
  "tpl": false,
  "s": "The Pinch opens its great claw wide..."
 },
 {
  "line": 189,
  "tpl": false,
  "s": "Mange howls for the pack!"
 },
 {
  "line": 190,
  "tpl": false,
  "s": "Mange crouches, hackles up..."
 },
 {
  "line": 193,
  "tpl": false,
  "s": "Cinderwing climbs into the ash, burning brighter..."
 },
 {
  "line": 196,
  "tpl": false,
  "s": "Glasshide's shell reflects the light!"
 },
 {
  "line": 197,
  "tpl": false,
  "s": "Glasshide raises its glittering tail..."
 },
 {
  "line": 201,
  "tpl": false,
  "s": "Gravemouth inhales. A hundred buried voices fall silent..."
 },
 {
  "line": 205,
  "tpl": false,
  "s": "The Choirmother raises her baton for the final verse..."
 },
 {
  "line": 208,
  "tpl": false,
  "s": "The Thornmaiden blooms, thorns everywhere!"
 },
 {
  "line": 209,
  "tpl": false,
  "s": "She holds out her hand. Do not take it..."
 },
 {
  "line": 212,
  "tpl": false,
  "s": "The seven brass suns align!"
 },
 {
  "line": 212,
  "tpl": false,
  "s": "Light gathers at the orrery's center..."
 },
 {
  "line": 216,
  "tpl": false,
  "s": "The Iron Duke takes a two-handed stance."
 },
 {
  "line": 217,
  "tpl": false,
  "s": "The Duke raises his greatsword high..."
 },
 {
  "line": 220,
  "tpl": false,
  "s": "The bell tolls, and a note takes shape!"
 },
 {
  "line": 221,
  "tpl": false,
  "s": "The great bell swings back, back, back..."
 },
 {
  "line": 224,
  "tpl": false,
  "s": "Moths pour from the petals!"
 },
 {
  "line": 225,
  "tpl": false,
  "s": "The Last Bloom drinks the whole garden's voice!"
 },
 {
  "line": 226,
  "tpl": false,
  "s": "A thousand petal-mouths open at once..."
 },
 {
  "line": 229,
  "tpl": false,
  "s": "The Bane of Harrow roars. Its wounds close!"
 },
 {
  "line": 230,
  "tpl": false,
  "s": "It drags itself up for one last killing lunge..."
 },
 {
  "line": 231,
  "tpl": false,
  "s": "The Bane lowers its head. Its jaws unhinge..."
 },
 {
  "line": 234,
  "tpl": false,
  "s": "The Black Star swallows the light. Time slows."
 },
 {
  "line": 235,
  "tpl": false,
  "s": "The Black Star collapses inward — everything is pulled toward it!"
 },
 {
  "line": 236,
  "tpl": false,
  "s": "Every light in the sky bends toward the Black Star..."
 },
