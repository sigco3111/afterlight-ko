[
 {
  "line": 84,
  "tpl": false,
  "s": "...He would say that. He always thought it was his fault. It took me years to understand it was our father's."
 },
 {
  "line": 165,
  "tpl": false,
  "s": "...Okay. I'll stay."
 },
 {
  "line": 184,
  "tpl": false,
  "s": "...There's my girl."
 },
 {
  "line": 275,
  "tpl": false,
  "s": "...Every good day I ever wanted to keep. All at once. It doesn't want anything else. It never will."
 },
 {
  "line": 304,
  "tpl": false,
  "s": "...We don't put it back."
 },
 {
  "line": 337,
  "tpl": false,
  "s": "...She was afraid of the dark."
 },
 {
  "line": 344,
  "tpl": false,
  "s": "...What is your name?"
 },
 {
  "line": 356,
  "tpl": false,
  "s": "...Now she'll know. Now we both will."
 },
 {
  "line": 363,
  "tpl": false,
  "s": "...The Afterlight."
 },
 {
  "line": 406,
  "tpl": false,
  "s": "...I want to be a Ranger. And a Cantor. And maybe a baker."
 },
 {
  "line": 424,
  "tpl": false,
  "s": "...Okay, ONE round."
 },
 {
  "line": 451,
  "tpl": false,
  "s": "...A quarter of an inch."
 },
 {
  "line": 469,
  "tpl": false,
  "s": "...Tomorrow. From Lanternfall."
 },
 {
  "line": 489,
  "tpl": false,
  "s": "...I'll come back. The last Halloway who sailed east never came back, I know. But I'm going to. Okay?"
 },
 {
  "line": 501,
  "tpl": false,
  "s": "...Yeah. That's her. Go on, say hello. Mind the edge."
 },
